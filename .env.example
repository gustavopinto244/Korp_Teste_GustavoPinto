# Copie para .env (`cp .env.example .env`) antes de `docker compose up`.
#
# Regra deste arquivo: só entra aqui variável que o docker-compose.yml
# realmente lê. Variável declarada mas ignorada é pior do que ausente — quem
# a edita esperando um efeito não recebe nem o efeito nem um erro.

# Credenciais do Postgres. O compose monta a DATABASE_URL de cada serviço a
# partir destas três variáveis (search_path=estoque e search_path=faturamento),
# então elas são a única fonte de verdade da conexão — não existe DSN
# separado por serviço para sair de sincronia.
POSTGRES_USER=korp
POSTGRES_PASSWORD=korp
POSTGRES_DB=korp

# Portas publicadas NO HOST. Mudam apenas o lado esquerdo do mapeamento de
# portas, para o caso de a porta já estar ocupada na máquina de quem avalia.
# Dentro da rede docker os serviços continuam em 8081/8082/80 — é isso que
# mantém o healthcheck e o proxy do nginx válidos qualquer que seja o valor
# aqui.
ESTOQUE_PORT=8081
FATURAMENTO_PORT=8082
FRONTEND_PORT=4200

# Inteligência Artificial (interpretação de notas por linguagem natural)
# mock: heurística determinística local, sem chamada externa (padrão atual)
# claude: integração real com a API da Anthropic (requer IA_API_KEY)
IA_PROVIDER=mock
IA_API_KEY=
