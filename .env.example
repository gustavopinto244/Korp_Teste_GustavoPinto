# Postgres
POSTGRES_USER=korp
POSTGRES_PASSWORD=korp
POSTGRES_DB=korp

# Serviço estoque
ESTOQUE_PORT=8081
ESTOQUE_DATABASE_URL=postgres://korp:korp@postgres:5432/korp?sslmode=disable&search_path=estoque

# Serviço faturamento
FATURAMENTO_PORT=8082
FATURAMENTO_DATABASE_URL=postgres://korp:korp@postgres:5432/korp?sslmode=disable&search_path=faturamento
ESTOQUE_BASE_URL=http://estoque:8081

# Inteligência Artificial (interpretação de notas por linguagem natural)
# mock: heurística determinística local, sem chamada externa (padrão atual)
# claude: integração real com a API da Anthropic (requer IA_API_KEY)
IA_PROVIDER=mock
IA_API_KEY=

# Frontend
FRONTEND_PORT=4200
